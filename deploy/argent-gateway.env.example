# /etc/default/argent-gateway — mode 0600, owned by root:argent-lite
# Installed by scripts/install.sh. Never committed.
#
# Generate a token with: openssl rand -hex 24
# The SAME token must be set in the dashboard's .env.local as VITE_GATEWAY_TOKEN
# so the React UI at :8080 can authenticate to the gateway at :18789.

ARGENT_GATEWAY_TOKEN=CHANGE_ME

# Optional overrides:
# ARGENT_GATEWAY_PORT=18789
# ARGENT_SKIP_CHANNELS=1
