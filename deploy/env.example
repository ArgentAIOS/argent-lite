# Argent Lite runtime environment.
# Copy to /etc/default/argent-lite and edit. Owned by root:argent-lite, mode 0640.

# Runtime mode: "satellite" or "standalone".
ARGENT_MODE=standalone

# Data + state directory. Must be writable by the argent-lite user.
ARGENT_HOME=/var/lib/argent-lite

# Log level: debug | info | warn | error.
ARGENT_LOG_LEVEL=info

# Master key for credential vault (AES-256-GCM). 32 bytes, base64-encoded.
# Generate with: openssl rand -base64 32
ARGENT_MASTER_KEY=
